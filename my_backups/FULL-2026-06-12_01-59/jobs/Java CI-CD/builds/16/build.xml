    <script>pipeline {
    // Directs Jenkins to run this pipeline exclusively on your slave machine
    agent { 
        label &apos;slave2&apos; 
    }
    
    tools {
        // Matches your configured Jenkins JDK name perfectly
        jdk &apos;JDK21.0.11&apos; 
    }
    
    stages {
        stage(&apos;Build&apos;) {
            steps {
                echo &apos;Pulling code from Git repository...&apos;
                git branch: &apos;master&apos;, url: &apos;https://github.com/jglick/simple-maven-project-with-tests.git&apos;
                
                echo &apos;Building and packaging...&apos;
                withMaven(maven: &apos;Maven3&apos;) { 
                    // -DskipTests ensures the build passes even if the repository contains broken unit tests
                    sh &apos;mvn clean package -DskipTests&apos;
                }
            }
        }
        
        stage(&apos;Test&apos;) {
            steps {
                echo &apos;Running unit tests...&apos;
                withMaven(maven: &apos;Maven3&apos;) {
                    // Executes the tests separately and logs results without crashing the pipeline
                    sh &apos;mvn test -Dmaven.test.failure.ignore=true&apos;
                }
            }
        }
        
        stage(&apos;Deploy&apos;) {
